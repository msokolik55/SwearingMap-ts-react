enum SubmissionStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
}

enum ModerationAction {
  APPROVE
  REJECT
  REQUEST_CHANGES
  ARCHIVE
}

model Submission {
  id                  String               @id @default(uuid()) @db.Uuid
  submitterId         String               @map("submitter_id") @db.Uuid
  languageId          String               @map("language_id") @db.Uuid
  countryId           String?              @map("country_id") @db.Uuid
  proposedTerm        String               @map("proposed_term") @db.VarChar(160)
  proposedDefinition  String               @map("proposed_definition") @db.Text
  proposedIntensity   Int                  @map("proposed_intensity") @db.SmallInt
  contextualNotes     String?              @map("contextual_notes") @db.Text
  status              SubmissionStatus     @default(DRAFT)
  submittedAt         DateTime?            @map("submitted_at") @db.Timestamptz(3)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  submitter           User                 @relation(fields: [submitterId], references: [id], onDelete: Restrict)
  language            Language             @relation(fields: [languageId], references: [id], onDelete: Restrict)
  country             Country?             @relation(fields: [countryId], references: [id], onDelete: Restrict)
  moderationDecisions ModerationDecision[]

  @@index([status, submittedAt])
  @@index([submitterId, createdAt])
  @@map("submissions")
}

model ModerationDecision {
  id           String           @id @default(uuid()) @db.Uuid
  submissionId String           @map("submission_id") @db.Uuid
  moderatorId  String           @map("moderator_id") @db.Uuid
  action       ModerationAction
  reason       String           @db.Text
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  submission   Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  moderator    User             @relation("ModeratorDecisions", fields: [moderatorId], references: [id], onDelete: Restrict)

  @@index([submissionId, createdAt])
  @@map("moderation_decisions")
}
