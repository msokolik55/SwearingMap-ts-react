generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
  previewFeatures     = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [fuzzystrmatch, plpgsql, postgis, postgis_tiger_geocoder, postgis_topology]
}
