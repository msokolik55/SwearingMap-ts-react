generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
  previewFeatures     = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [fuzzystrmatch, plpgsql, postgis, postgis_tiger_geocoder, postgis_topology]
}

enum RoleKey {
  USER
  MODERATOR
  ADMIN
}

enum ContentStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
}

enum ModerationAction {
  APPROVE
  REJECT
  REQUEST_CHANGES
  ARCHIVE
}

enum QuizQuestionType {
  MEANING_TO_WORD
  WORD_TO_MEANING
}

enum NotificationType {
  SUBMISSION_STATUS
  NEW_LANGUAGE_CONTENT
  PRODUCT_UPDATE
}

model User {
  id                  String                   @id @default(uuid()) @db.Uuid
  email               String                   @unique @db.VarChar(320)
  displayName         String?                  @map("display_name") @db.VarChar(120)
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  roles               UserRole[]
  sessions            Session[]
  submittedWords      SwearWord[]              @relation("SubmittedWords")
  ratings             IntensityRating[]
  submissions         Submission[]
  moderationDecisions ModerationDecision[]     @relation("ModeratorDecisions")
  quizAttempts        QuizAttempt[]
  notifications       Notification[]
  notificationPrefs   NotificationPreference[]
  pushSubscriptions   PushSubscription[]

  @@map("users")
}

model Role {
  key         RoleKey    @id
  description String     @db.VarChar(255)
  users       UserRole[]

  @@map("roles")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleKey    RoleKey  @map("role_key")
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleKey], references: [key], onDelete: Restrict)

  @@id([userId, roleKey])
  @@map("user_roles")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model Language {
  id                String                   @id @default(uuid()) @db.Uuid
  code              String                   @unique @db.VarChar(10)
  name              String                   @db.VarChar(100)
  nativeName        String                   @map("native_name") @db.VarChar(100)
  active            Boolean                  @default(true)
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  countries         CountryLanguage[]
  words             SwearWord[]
  submissions       Submission[]
  quizAttempts      QuizAttempt[]
  notificationPrefs NotificationPreference[]

  @@map("languages")
}

model Country {
  id          String                                @id @default(uuid()) @db.Uuid
  iso2        String                                @unique @db.Char(2)
  iso3        String                                @unique @db.Char(3)
  slug        String                                @unique @db.VarChar(100)
  name        String                                @db.VarChar(100)
  mapCenter   Unsupported("geography(Point,4326)")? @map("map_center")
  createdAt   DateTime                              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime                              @updatedAt @map("updated_at") @db.Timestamptz(3)
  languages   CountryLanguage[]
  words       SwearWord[]
  submissions Submission[]

  @@map("countries")
}

model CountryLanguage {
  countryId  String   @map("country_id") @db.Uuid
  languageId String   @map("language_id") @db.Uuid
  primary    Boolean  @default(false)
  country    Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  language   Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@id([countryId, languageId])
  @@map("country_languages")
}

model SwearWord {
  id                 String                  @id @default(uuid()) @db.Uuid
  languageId         String                  @map("language_id") @db.Uuid
  countryId          String?                 @map("country_id") @db.Uuid
  submittedById      String?                 @map("submitted_by_id") @db.Uuid
  term               String                  @db.VarChar(160)
  normalizedTerm     String                  @map("normalized_term") @db.VarChar(160)
  slug               String                  @db.VarChar(180)
  status             ContentStatus           @default(DRAFT)
  editorialIntensity Int?                    @map("editorial_intensity") @db.SmallInt
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  language           Language                @relation(fields: [languageId], references: [id], onDelete: Restrict)
  country            Country?                @relation(fields: [countryId], references: [id], onDelete: Restrict)
  submittedBy        User?                   @relation("SubmittedWords", fields: [submittedById], references: [id], onDelete: SetNull)
  meanings           Meaning[]
  usageExamples      UsageExample[]
  sources            Source[]
  sourceEquivalents  TranslationEquivalent[] @relation("SourceWord")
  targetEquivalents  TranslationEquivalent[] @relation("TargetWord")
  ratings            IntensityRating[]
  quizQuestions      QuizQuestion[]

  @@unique([languageId, countryId, normalizedTerm])
  @@unique([languageId, slug])
  @@index([status, languageId])
  @@map("swear_words")
}

model Meaning {
  id          String    @id @default(uuid()) @db.Uuid
  swearWordId String    @map("swear_word_id") @db.Uuid
  definition  String    @db.Text
  locale      String    @default("en") @db.VarChar(10)
  position    Int       @default(0) @db.SmallInt
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  swearWord   SwearWord @relation(fields: [swearWordId], references: [id], onDelete: Cascade)

  @@unique([swearWordId, locale, position])
  @@map("meanings")
}

model UsageExample {
  id          String    @id @default(uuid()) @db.Uuid
  swearWordId String    @map("swear_word_id") @db.Uuid
  example     String    @db.Text
  translation String?   @db.Text
  locale      String    @default("en") @db.VarChar(10)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  swearWord   SwearWord @relation(fields: [swearWordId], references: [id], onDelete: Cascade)

  @@index([swearWordId])
  @@map("usage_examples")
}

model Source {
  id          String    @id @default(uuid()) @db.Uuid
  swearWordId String    @map("swear_word_id") @db.Uuid
  title       String    @db.VarChar(255)
  url         String?   @db.VarChar(2048)
  citation    String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  swearWord   SwearWord @relation(fields: [swearWordId], references: [id], onDelete: Cascade)

  @@index([swearWordId])
  @@map("sources")
}

model TranslationEquivalent {
  id           String        @id @default(uuid()) @db.Uuid
  sourceWordId String        @map("source_word_id") @db.Uuid
  targetWordId String        @map("target_word_id") @db.Uuid
  confidence   Float?
  notes        String?       @db.Text
  status       ContentStatus @default(PENDING_REVIEW)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  sourceWord   SwearWord     @relation("SourceWord", fields: [sourceWordId], references: [id], onDelete: Cascade)
  targetWord   SwearWord     @relation("TargetWord", fields: [targetWordId], references: [id], onDelete: Cascade)

  @@unique([sourceWordId, targetWordId])
  @@index([targetWordId, status])
  @@map("translation_equivalents")
}

model IntensityRating {
  userId      String    @map("user_id") @db.Uuid
  swearWordId String    @map("swear_word_id") @db.Uuid
  value       Int       @db.SmallInt
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  swearWord   SwearWord @relation(fields: [swearWordId], references: [id], onDelete: Cascade)

  @@id([userId, swearWordId])
  @@index([swearWordId])
  @@map("intensity_ratings")
}

model Submission {
  id                  String               @id @default(uuid()) @db.Uuid
  submitterId         String               @map("submitter_id") @db.Uuid
  languageId          String               @map("language_id") @db.Uuid
  countryId           String?              @map("country_id") @db.Uuid
  proposedTerm        String               @map("proposed_term") @db.VarChar(160)
  proposedDefinition  String               @map("proposed_definition") @db.Text
  proposedIntensity   Int                  @map("proposed_intensity") @db.SmallInt
  contextualNotes     String?              @map("contextual_notes") @db.Text
  status              SubmissionStatus     @default(DRAFT)
  submittedAt         DateTime?            @map("submitted_at") @db.Timestamptz(3)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  submitter           User                 @relation(fields: [submitterId], references: [id], onDelete: Restrict)
  language            Language             @relation(fields: [languageId], references: [id], onDelete: Restrict)
  country             Country?             @relation(fields: [countryId], references: [id], onDelete: Restrict)
  moderationDecisions ModerationDecision[]

  @@index([status, submittedAt])
  @@index([submitterId, createdAt])
  @@map("submissions")
}

model ModerationDecision {
  id           String           @id @default(uuid()) @db.Uuid
  submissionId String           @map("submission_id") @db.Uuid
  moderatorId  String           @map("moderator_id") @db.Uuid
  action       ModerationAction
  reason       String           @db.Text
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  submission   Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  moderator    User             @relation("ModeratorDecisions", fields: [moderatorId], references: [id], onDelete: Restrict)

  @@index([submissionId, createdAt])
  @@map("moderation_decisions")
}

model QuizAttempt {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String?        @map("user_id") @db.Uuid
  languageId    String         @map("language_id") @db.Uuid
  score         Int?           @db.SmallInt
  questionCount Int            @map("question_count") @db.SmallInt
  completedAt   DateTime?      @map("completed_at") @db.Timestamptz(3)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  language      Language       @relation(fields: [languageId], references: [id], onDelete: Restrict)
  questions     QuizQuestion[]

  @@index([userId, createdAt])
  @@map("quiz_attempts")
}

model QuizQuestion {
  id             String           @id @default(uuid()) @db.Uuid
  attemptId      String           @map("attempt_id") @db.Uuid
  swearWordId    String           @map("swear_word_id") @db.Uuid
  type           QuizQuestionType
  selectedAnswer String?          @map("selected_answer") @db.Text
  correct        Boolean?
  position       Int              @db.SmallInt
  attempt        QuizAttempt      @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  swearWord      SwearWord        @relation(fields: [swearWordId], references: [id], onDelete: Restrict)

  @@unique([attemptId, position])
  @@map("quiz_questions")
}

model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  recipientId String           @map("recipient_id") @db.Uuid
  type        NotificationType
  title       String           @db.VarChar(180)
  body        String           @db.Text
  payload     Json?
  readAt      DateTime?        @map("read_at") @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  recipient   User             @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  type       NotificationType
  languageId String?          @map("language_id") @db.Uuid
  inApp      Boolean          @default(true) @map("in_app")
  push       Boolean          @default(false)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  language   Language?        @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@index([languageId])
  @@unique([userId, type, languageId])
  @@map("notification_preferences")
}

model PushSubscription {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  endpoint  String    @unique @db.Text
  p256dh    String    @db.Text
  auth      String    @db.Text
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}
