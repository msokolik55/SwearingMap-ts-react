{
	"name": "swearing-map",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "pnpm@11.13.0",
	"engines": {
		"node": ">=24 <25",
		"pnpm": ">=11.13 <12"
	},
	"scripts": {
		"prepare": "node .husky/install.mjs",
		"nx": "nx",
		"ci:change-plan": "node scripts/ci-change-plan.mjs",
		"dev": "nx dev web",
		"dev:api": "nx serve api",
		"dev:map": "nx dev map",
		"dev:web": "nx dev web",
		"db:up": "docker compose --file docker/compose.yml up --detach --wait database",
		"db:down": "docker compose --file docker/compose.yml down",
		"db:generate": "prisma generate",
		"db:check": "prisma validate && prisma generate",
		"db:migrate": "prisma migrate deploy",
		"db:migrate:dev": "prisma migrate dev",
		"db:seed": "prisma db seed",
		"generate": "nx run-many -t generate --parallel=2 && node scripts/generated-sources-state.mjs write",
		"generated:check": "node scripts/generated-sources-state.mjs check",
		"api:openapi": "nx run api-client:openapi",
		"api:openapi:raw": "tsx --tsconfig apps/api/tsconfig.app.json scripts/generate-openapi.ts",
		"api:client:generate": "nx run api-client:generate",
		"build": "nx run-many -t build --parallel=2 && pnpm assemble:site",
		"build:site": "nx run-many -t build --projects=web,map --parallel=2 && pnpm assemble:site",
		"assemble:site": "node scripts/assemble-site.mjs",
		"check:bundle-budget": "node scripts/check-bundle-budget.mjs",
		"check:quality:projects": "nx run-many -t lint typecheck test --parallel=4",
		"preview": "vite preview --outDir dist/site",
		"typecheck": "nx run-many -t typecheck --parallel=2 && pnpm typecheck:e2e",
		"typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
		"lint": "nx run-many -t lint --parallel=2 && pnpm lint:workspace",
		"lint:fix": "eslint . --fix",
		"lint:workspace": "eslint . --ignore-pattern \"apps/**\" --ignore-pattern \"libs/**\" --max-warnings=0",
		"format": "prettier . --write",
		"format:check": "prettier . --check",
		"test": "nx run-many -t test --parallel=2 && pnpm test:tooling",
		"test:tooling": "node --test scripts/*.test.mjs",
		"test:database": "node scripts/test-database.mjs",
		"test:coverage": "nx test map --coverage",
		"test:e2e": "pnpm build && playwright test",
		"test:e2e:ci": "playwright test",
		"test:lighthouse": "pnpm build && lhci autorun",
		"test:lighthouse:ci": "lhci autorun",
		"container:build": "docker build --tag swearing-map:local .",
		"container:smoke": "node scripts/smoke-container.mjs",
		"container:api:build": "docker build --file docker/api.Dockerfile --tag swearing-map-api:local .",
		"container:api:smoke": "node scripts/smoke-api-container.mjs",
		"fallow:audit": "pnpm generate && fallow audit --base origin/main --gate new-only --threads 2",
		"fallow:ci": "pnpm generate && pnpm fallow:ci:generated",
		"fallow:ci:generated": "pnpm generated:check && node scripts/fallow-ci.mjs",
		"fallow:full": "pnpm generate && pnpm fallow:full:generated",
		"fallow:full:generated": "pnpm generated:check && node scripts/fallow-full.mjs",
		"verify:staged": "lint-staged",
		"verify:changed": "node scripts/verify-changed.mjs",
		"verify:push": "pnpm verify:changed",
		"verify:ci": "pnpm fallow:ci && pnpm check",
		"verify:full": "pnpm audit && pnpm check && pnpm test:e2e:ci && pnpm test:lighthouse:ci",
		"push:safe": "node scripts/safe-push.mjs",
		"test:watch": "nx test map --watch",
		"audit": "pnpm --config.auditConfig.ignoreGhsas=[] audit --prod --audit-level high && pnpm audit --dev --audit-level high",
		"check": "pnpm generate && pnpm check:generated",
		"check:generated": "pnpm check:quality:generated && pnpm build",
		"check:quality:generated": "pnpm generated:check && pnpm format:check && pnpm check:quality:projects && pnpm lint:workspace && pnpm typecheck:e2e && pnpm test:tooling"
	},
	"devDependencies": {
		"@commitlint/cli": "21.2.1",
		"@commitlint/config-conventional": "21.2.0",
		"@eslint/js": "^9.39.5",
		"@hey-api/openapi-ts": "0.99.0",
		"@lhci/cli": "^0.15.1",
		"@nestjs/schematics": "^11.0.0",
		"@nestjs/testing": "^11.0.0",
		"@nx/eslint": "23.1.0",
		"@nx/js": "23.1.0",
		"@nx/nest": "23.1.0",
		"@nx/next": "23.1.0",
		"@nx/node": "23.1.0",
		"@nx/vite": "23.1.0",
		"@nx/vitest": "23.1.0",
		"@nx/web": "23.1.0",
		"@nx/webpack": "23.1.0",
		"@playwright/test": "^1.61.1",
		"@swc/helpers": "~0.5.18",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/leaflet": "^1.9.0",
		"@types/node": "^24.13.3",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react-swc": "^4.3.1",
		"@vitest/coverage-v8": "^4.1.10",
		"dotenv": "17.4.2",
		"eslint": "^9.39.5",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.4.26",
		"fallow": "3.7.1",
		"globals": "^16.5.0",
		"husky": "9.1.7",
		"jsdom": "^29.1.1",
		"lint-staged": "17.0.8",
		"next": "16.2.12",
		"nx": "23.1.0",
		"prettier": "^3.9.5",
		"prisma": "7.9.0",
		"tslib": "2.8.1",
		"tsx": "4.23.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.64.0",
		"vite": "^8.1.4",
		"vitest": "^4.1.10",
		"webpack": "^5.101.3",
		"webpack-cli": "^7.0.0",
		"webpack-dev-server": "^5.2.1"
	}
}
